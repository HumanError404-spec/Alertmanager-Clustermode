[Unit]
Description=Alertmanager
Wants=network-online.target
After=network-online.target

[Service]
User={{ alertmanager_user | default('victoria') }}
Group={{ alertmanager_group | default('victoria') }}
Type=simple
Restart=on-failure
ExecStart=/usr/local/bin/alertmanager \
  --config.file={{ config_directory }}/alertmanager.yml \
  --storage.path={{ alertmanager_storage_path | default('/var/lib/alertmanager') }} \
  --web.listen-address={{ alertmanager_listen_address | default(':9093') }} \
  --cluster.listen-address=0.0.0.0:9094 \
  --cluster.advertise-address={{ alertmanager_cluster_advertise }} \
  {% for peer in alertmanager_cluster_peers %}--cluster.peer={{ peer }} {% endfor %}

[Install]
WantedBy=multi-user.target
